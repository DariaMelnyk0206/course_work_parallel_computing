@startuml sequence_uc1_index
title UC-1: Індексація корпусу (POST /api/index)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam defaultFontSize 14
skinparam maxMessageSize 260
actor "Клієнт" as C
participant "ApiServer [request_pool]" as A
participant SearchService as S
participant IndexBuilder as B
participant "Воркер [index_pool]" as W
participant StripedHashTable as T
C -> A : POST /api/index {"threads": N}
note right of A : threads не ціле або поза 1..256 → 400
A -> S : BuildIndex(N) [CAS прапорця]
alt індексація вже триває
  S --> A : kAlreadyInProgress
  A --> C : 409
else прапорець захоплено
  S -> B : Build(dir, N)
  B -> B : сканування файлів, metadata.csv
  loop для кожного файлу
    B -> W : Submit(файл)
  end
  par воркери паралельно
    W -> W : читання, токенізація зі зсувами,\nлокальна агрегація (без блокувань)
    W -> T : InsertBatch(stripe) [unique_lock]
  end
  B -> B : future.get() для всіх задач
  B --> S : новий індекс
  S -> S : публікація знімка [index_mutex_]
  S --> A : documents_indexed, time_ms
  A --> C : 200 {"status", "documents_indexed", "time_ms"}
end
@enduml
