@startuml sequence_uc1_index
title UC-1: Index the corpus (POST /api/index)
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Web UI / CLI" as Client
participant "ApiServer\n(request_pool thread)" as Api
participant SearchService as Svc
participant IndexBuilder as Builder
participant "index_pool\n(ThreadPool, N)" as Pool
participant "Worker i\n(index_pool thread)" as Worker
participant StripedHashTable as Table
participant DocumentTable as Docs

Client -> Api : POST /api/index {"threads": N}
activate Api
Api -> Api : validate JSON and 'threads' (1..256)
alt invalid input
  Api --> Client : 400 {"error": ...}
end
Api -> Svc : BuildIndex(N)
activate Svc
Svc -> Svc : indexing_ CAS(false -> true)
alt already running
  Svc --> Api : conflict
  Api --> Client : 409 {"error": "Indexing already in progress"}
end
Svc -> Builder : Build(dataset_dir, N)
activate Builder
Builder -> Builder : start steady_clock timer
Builder -> Builder : scan dataset, sort file list\n(sequential part)
Builder -> Table : create new StripedHashTable
Builder -> Docs : allocate slots[file_count]
Builder -> Pool : create ThreadPool(N), unbounded queue
loop for each file
  Builder -> Pool : Submit(task(doc_id)) -> future
end

par one task per file, running on index_pool workers
  Pool -> Worker : run task(doc_id)
  activate Worker
  Worker -> Worker : read file into buffer
  Worker -> Worker : build snippet
  Worker -> Worker : tokenize into local unordered_set\n(local aggregation, no locks)
  Worker -> Worker : FNV-1a hash per term,\ngroup terms by stripe
  loop for each stripe with terms
    Worker -> Table : InsertBatch(stripe, items)
    activate Table
    Table -> Table : unique_lock(stripe mutex)
    Table -> Table : append doc_id to postings
    Table -> Table : unlock
    Table --> Worker
    deactivate Table
  end
  Worker -> Docs : write DocumentInfo into own slot[doc_id]\n(no lock)
  Worker -> Worker : indexed_count.fetch_add(1)
  Worker --> Pool : future ready
  deactivate Worker
end

Builder -> Pool : future.get() for every task\n(happens-before)
Builder -> Pool : destroy index_pool (shutdown, join)
Builder -> Builder : stop timer, time_ms
Builder --> Svc : IndexBuildResult(documents, time_ms)
deactivate Builder

Svc -> Svc : lock(mutex) swap shared_ptr<const InvertedIndex>\n(publish snapshot), unlock
Svc -> Svc : update stats (documents, time, threads_used = N)
Svc -> Svc : indexing_ = false
Svc --> Api : IndexOutcome ok
deactivate Svc
Api --> Client : 200 {"status": "ok", "documents_indexed": D, "time_ms": T}
deactivate Api

note over Client, Docs
  Searches running during the build keep using the old snapshot.
  A search started after publication sees the new index.
end note
@enduml
