@startuml sequence_uc2_ws_search
title UC-2: Пошук зі стрімінгом етапів (WS /ws/search)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam defaultFontSize 14
skinparam maxMessageSize 260
actor "Web UI" as C
participant "ApiServer [request_pool]" as A
participant SearchService as S
participant OllamaClient as O
participant "Індекс" as I
C -> A : WS {"query"}
A -> S : ExpandQuery(query)
S -> O : Expand(query, terms)\n[try_lock_for, fallback при тайм-ауті]
O --> S : expanded_terms
S --> A : QueryExpansion
A --> C : {"stage": "query_expansion"}
A -> S : RunKeywordSearch(expansion)
S -> I : Lookup(term) [shared_lock]
I --> S : postings
S --> A : results
A --> C : {"stage": "keyword_search"}
A --> C : {"stage": "done"}
note over A : сесію обслуговує один потік request_pool;\nпомилка запиту → stage "error", close 1008
@enduml
