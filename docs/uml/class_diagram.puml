@startuml class_diagram
title Діаграма класів: архітектура (за src/*.h)
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

abstract class "httplib::TaskQueue" as TaskQueue {
  {abstract} +enqueue(fn)
  {abstract} +shutdown()
}

class Config <<struct>> {
  +port, dataset_dir, web_dir
  +ollama_host, ollama_model
  +llm_timeout_ms, expansion_enabled
  +request_threads, request_queue, top_k
  +{static} FromEnvironment()
}

class ApiServer {
  -config_
  -service_
  +Listen()
  +Stop()
}

class SearchService {
  -index_mutex_
  -index_ : shared_ptr<const InvertedIndex>
  -indexing_in_progress_ : atomic<bool>
  +BuildIndex(num_threads, ...)
  +ExpandQuery(query)
  +RunKeywordSearch(expansion)
  +Stats()
  +OllamaAvailable()
}

class ThreadPool <<final>> {
  -workers_ : vector<jthread>
  -tasks_, mutex_, cv_
  +enqueue(fn)
  +shutdown()
  +Submit(task)
}

class IndexBuilder {
  +{static} Build(dataset_dir, num_threads)
  +{static} ParseMetadataLine(line)
}

class InvertedIndex {
  +Table()
  +Documents()
  +DocumentCount()
}

class StripedHashTable {
  +InsertBatch(stripe, items)
  +Lookup(term, hash)
  +{static} Fnv1aHash64(term)
}

class DocumentTable {
  +Set(doc_id, info)
  +Get(doc_id)
}

class Ranker {
  +{static} Rank(terms, index, top_k, ...)
}

class OllamaClient {
  -generate_mutex_ : timed_mutex
  +Expand(original_query, original_terms)
  +IsAvailable()
}

class Tokenizer {
  +{static} Tokenize(text)
  +{static} TokenizeWithOffsets(text)
}

TaskQueue <|-- ThreadPool

ApiServer ..> ThreadPool : «створює через new_task_queue»\n(request_pool; власник — httplib)
IndexBuilder ..> ThreadPool : «створює» index_pool

ApiServer *-- Config
ApiServer o-- SearchService : shared_ptr
SearchService *-- Config
SearchService *-- OllamaClient
SearchService o-- "0..1" InvertedIndex : поточний знімок\n(shared_ptr<const>)
InvertedIndex *-- StripedHashTable
InvertedIndex *-- DocumentTable

SearchService ..> IndexBuilder : Build → IndexBuildResult
SearchService ..> Ranker : Rank → RankedDocument
SearchService ..> Tokenizer
IndexBuilder ..> InvertedIndex : «створює»
IndexBuilder ..> Tokenizer
Ranker ..> InvertedIndex : Lookup
OllamaClient ..> Tokenizer : розбір відповіді\n→ ExpansionResult

note bottom of SearchService
  ExpandQuery повертає QueryExpansion,
  RunKeywordSearch повертає KeywordSearchOutcome,
  Stats повертає IndexStats (лише типи результатів).
end note

note as N1
  Logger (singleton) використовується всіма компонентами.
end note
@enduml
