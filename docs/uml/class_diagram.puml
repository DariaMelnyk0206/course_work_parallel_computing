@startuml class_diagram
title Діаграма класів
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 60
skinparam defaultFontSize 14
hide empty members

class ApiServer {
  -config_
  -service_
  +Listen()
  +Stop()
}

class SearchService {
  -index_mutex_ : mutex
  -index_ : shared_ptr<const InvertedIndex>
  -indexing_in_progress_ : atomic<bool>
  +BuildIndex(n)
  +ExpandQuery(query)
  +RunKeywordSearch(expansion)
  +Stats()
}

class OllamaClient {
  -generate_mutex_ : timed_mutex
  +Expand(query, terms)
  +IsAvailable()
}

class IndexBuilder {
  +{static} Build(dir, n)
}

class Ranker {
  +{static} Rank(terms, index, top_k)
}

class ThreadPool <<final>> {
  -workers_ : vector<jthread>
  -tasks_ : queue
  +enqueue(fn)
  +shutdown()
  +Submit(task)
}

abstract class "httplib::TaskQueue" as TaskQueue {
  {abstract} +enqueue(fn)
  {abstract} +shutdown()
}

class InvertedIndex {
  +Table()
  +Documents()
  +DocumentCount()
}

class StripedHashTable {
  -buckets_ : vector<vector<Entry>>
  -stripes_ : vector<shared_mutex>
  +InsertBatch(stripe, items)
  +Lookup(term, hash)
  +{static} Fnv1aHash64(term)
}

class DocumentTable {
  -documents_ : vector<DocumentInfo>
  +Set()
  +Get()
}

class "StripedHashTable::Entry" as Entry <<struct>> {
  term
  postings : vector<Posting>
}

class Posting <<struct>> {
  doc_id
  offset
}

class DocumentInfo <<struct>> {
  name
  relative_path
  title
  snippet
  valid
}

ApiServer o-- SearchService
SearchService *-- OllamaClient
SearchService ..> IndexBuilder
SearchService ..> Ranker
SearchService o-- InvertedIndex : знімок
ApiServer ..> ThreadPool : «створює request_pool»
IndexBuilder ..> ThreadPool : «створює index_pool»
IndexBuilder ..> InvertedIndex : «будує»
Ranker ..> InvertedIndex : «Lookup»
ThreadPool --|> TaskQueue
InvertedIndex *-- StripedHashTable
InvertedIndex *-- DocumentTable
StripedHashTable *-- "0..*" Entry
Entry *-- "0..*" Posting
DocumentTable *-- "0..*" DocumentInfo

OllamaClient -[hidden]right- IndexBuilder
IndexBuilder -[hidden]right- Ranker
SearchService -[hidden]down- IndexBuilder

note right of StripedHashTable
  бакет = h & (B−1), стрип = бакет & (S−1);
  запис — unique_lock, читання — shared_lock
end note

note as N1
  Config, Tokenizer, Logger
  використовуються кількома компонентами
end note
@enduml
