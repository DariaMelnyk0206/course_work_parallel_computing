@startuml sequence_uc3_rest_search
title UC-3: Пошук через REST (POST /api/search)
skinparam responseMessageBelowArrow true
actor "Користувач CLI" as Cli
participant "ApiServer\n(handler у потоці request_pool)" as Api
participant "SearchService" as Svc
participant "Tokenizer" as Tok
participant "OllamaClient" as Ollama
participant "std::timed_mutex\n(черга LLM)" as Mtx
participant "Ollama\n(/api/generate)" as Llm
participant "InvertedIndex\n(знімок)" as Idx
participant "StripedHashTable\n(shared_mutex стрипа)" as Tbl
participant "Ranker" as Rank
participant "Файли корпусу\n(DATASET_DIR)" as Fs
Cli -> Api : POST /api/search\n{"query": "...", "mode": "keyword"}
note right of Api
  З'єднання обслуговує окремий потік request_pool
end note
Api -> Api : t0 = steady_clock::now(),\nвалідація JSON, query, mode
alt невалідний запит
  Api --> Cli : 400 {"error": "..."}
else валідний запит
  Api -> Svc : ExpandQuery(query)
  Svc -> Tok : Tokenize(query)
  Tok --> Svc : оригінальні терміни (унікальні)
  alt EXPANSION=off
    Svc -> Svc : Expand не викликається, new_terms = []
  else EXPANSION=on
    Svc -> Ollama : Expand(query, original_terms)
    Ollama -> Mtx : try_lock_until(now + LLM_TIMEOUT_MS)
    alt м'ютекс отримано в межах бюджету
      Ollama -> Llm : POST /api/generate (timeout = залишок бюджету)
      Ollama -> Mtx : unlock()
      alt успішна відповідь з новими термінами
        Llm --> Ollama : response
        Ollama -> Tok : Tokenize(response)
        Ollama --> Svc : нові терміни (≤ 10)
      else помилка / тайм-аут HTTP / порожній розбір
        Ollama --> Svc : fallback: порожній список, подія в лог
      end
    else бюджет вичерпано в черзі
      Ollama --> Svc : fallback: порожній список, подія в лог
    end
  end
  Svc --> Api : QueryExpansion\n(expanded_terms = оригінальні w=2 + нові w=1)
  note over Svc
    М'ютекс LLM вже звільнено, індекс під час очікування LLM не блокується.
  end note
  Api -> Svc : RunKeywordSearch(expansion)
  Svc -> Svc : CurrentIndex() (копія shared_ptr під index_mutex_)
  Svc -> Rank : Rank(weighted_terms, *index, top_k)
  loop для кожного унікального терміна
    Rank -> Idx : Table()
    Rank -> Tbl : Lookup(term, hash)
    note right of Tbl : shared_lock на один стрип,\nкопія списку постингів
    Tbl --> Rank : postings (df = size)
  end
  Rank --> Svc : vector<RankedDocument>\n(doc_index, score, anchor_offset, anchor_term)
  note over Svc, Tbl : Усі shared_lock на стрипи вже відпущено
  Svc -> Svc : AttachSnippets(dataset_dir, *index, ranked)
  loop кожен документ із top-k (поза будь-якими блокуваннями)
    Svc -> Idx : Documents().Get(doc_index)\n(relative_path, статичний snippet)
    Svc -> Fs : BuildKwicSnippet(path, anchor_offset, anchor_term)\nвідкрити файл, прочитати вікно ±100 байтів
    alt за зсувом стоїть anchor_term
      Fs --> Svc : KWIC-snippet (≤ 160 байтів, "..." по краях)
    else файл недоступний, коротший або термін не збігся
      Fs --> Svc : std::nullopt
      Svc -> Svc : резервний статичний snippet з DocumentInfo
    end
  end
  Svc --> Api : KeywordSearchOutcome
  Api -> Api : time_ms = повний час від t0\n(expansion + пошук + читання вікон)
  Api --> Cli : 200 {"results": [{doc_id, score, snippet} (без title)], "time_ms": T}
end
note over Cli, Api
  Той самий пайплайн, що в UC-2, але одна відповідь
  замість трьох WS-повідомлень.
end note
@enduml
