@startuml sequence_uc3_rest_search
title UC-3: Пошук через REST (POST /api/search)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam defaultFontSize 14
skinparam maxMessageSize 260
actor "Клієнт (CLI)" as C
participant "ApiServer [request_pool]" as A
participant SearchService as S
participant OllamaClient as O
participant Ollama as L
participant "Індекс" as I
C -> A : POST /api/search {"query", "mode"}
A -> S : ExpandQuery(query)
S -> O : Expand(query, terms) [try_lock_for]
alt успіх
  O -> L : POST /api/generate
  L --> O : ключові слова
else тайм-аут або помилка
  O --> S : fallback: лише терміни запиту
end
O --> S : expanded_terms
A -> S : RunKeywordSearch(expansion)
loop для кожного терміна
  S -> I : Lookup(term) [shared_lock]
  I --> S : postings
end
S -> S : score, top-k, KWIC-вікна з файлів
S --> A : results
A --> C : 200 {"results", "time_ms"}
@enduml
