@startuml sequence_uc5_health
title UC-5: Перевірка стану (GET /api/health)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam defaultFontSize 14
skinparam maxMessageSize 260
actor "Клієнт" as C
participant "ApiServer [request_pool]" as A
participant SearchService as S
participant OllamaClient as O
participant Ollama as L
C -> A : GET /api/health
A -> S : OllamaAvailable()
S -> O : IsAvailable()
O -> L : GET /api/tags (тайм-аут 1 с)
L --> O : список моделей
O --> S : bool
S --> A : bool
A --> C : 200 {"status", "ollama"}
note over O : черга LLM не використовується;\nвідповідь завжди 200
@enduml
